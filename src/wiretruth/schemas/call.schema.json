{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kartsan03.github.io/wiretruth/schemas/call.schema.json",
  "title": "wiretruth call spec",
  "description": "The provider-neutral call the runner writes to a shim's stdin. Scenarios reuse its fields.",
  "type": "object",
  "$ref": "#/$defs/call_fields",
  "required": [
    "format",
    "scenario",
    "provider",
    "model",
    "stream",
    "messages",
    "max_output_tokens",
    "stop",
    "tools",
    "tool_choice",
    "output_schema",
    "reasoning",
    "extra"
  ],
  "properties": {
    "format": { "const": "wiretruth.call/v1" },
    "scenario": { "$ref": "common.schema.json#/$defs/scenario_id" },
    "provider": { "$ref": "common.schema.json#/$defs/provider_id" },
    "model": { "$ref": "common.schema.json#/$defs/nonempty_string" }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "call_fields": {
      "description": "The fields of a call. Which ones are required depends on where they are used.",
      "type": "object",
      "properties": {
        "stream": { "type": "boolean" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "stop": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/nonempty_string" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" }
        },
        "tool_choice": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "enum": ["auto", "required", "none"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/tool_name" } }
            }
          ]
        },
        "output_schema": {
          "description": "A JSON Schema for structured output, passed through as is.",
          "type": ["object", "null"]
        },
        "reasoning": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["effort"],
              "properties": {
                "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] }
              }
            }
          ]
        },
        "extra": {
          "description": "Scenario-specific hints, such as {\"include_usage\": true}.",
          "type": "object"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "parameters"],
      "properties": {
        "name": { "$ref": "#/$defs/tool_name" },
        "description": { "type": "string" },
        "parameters": {
          "description": "A JSON Schema for the arguments, passed through as is.",
          "type": "object"
        }
      }
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    }
  }
}
